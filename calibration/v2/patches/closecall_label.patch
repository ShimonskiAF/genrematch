+// Close calls (v2-tweaks C): top two shelves are a pair the model confuses and are under CLOSE.gap apart.
+// Confidence is capped at medium and the label names the family (or both families) instead of one shelf.
+export const CLOSE = { gap: 0.08, on: true, pairs: [[['peaktechno'], ['house', 'techhouse', 'basshouse', 'speedhouse', 'deephouse']], [['rnb'], ['soul']]] };
+export function closeCall(P, close = CLOSE) {
+  const [a, b] = Object.keys(P).sort((x, y) => P[y] - P[x]);
+  if (!b || P[a] - P[b] >= close.gap) return null;
+  return close.pairs.some(([L, R]) => (L.includes(a) && R.includes(b)) || (L.includes(b) && R.includes(a))) ? [a, b] : null;
